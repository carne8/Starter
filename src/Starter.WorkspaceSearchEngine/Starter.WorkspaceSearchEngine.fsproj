<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ParallelCompilation>true</ParallelCompilation>
        <Deterministic>false</Deterministic>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsPlugin>true</IsPlugin>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Images/*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Compile Include="Types.fs" />
        <Compile Include="Icons.fs" />
        <Compile Include="WorkspaceSources\Common.fs" />
        <Compile Include="WorkspaceSources\VsCode.fs" />
        <Compile Include="WorkspaceSources\JetBrains.fs" />
        <Compile Include="WorkspaceSources\AndroidStudio.fs" />
        <Compile Include="WorkspaceSources\WindowsTerminal.fs" />
        <Compile Include="WorkspaceSources\WorkspaceSourceProvider.fs" />
        <Compile Include="Settings.axaml.fs" />

        <Compile Include="Library.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="StarterApp.SearchEngineBase" Version="0.2.0">
            <ExcludeAssets>runtime;native</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.8" />
        <PackageReference Include="FluentAvaloniaUI" Version="3.0.1" />
        <PackageReference Include="FsToolkit.ErrorHandling" Version="5.1.0" />
        <PackageReference Include="ObservableCollections" Version="3.3.4" />
    </ItemGroup>

</Project>
