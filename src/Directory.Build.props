<Project>
  <ItemGroup Condition="'$(IsPlugin)' == 'true'">
    <PackageReference Include="Avalonia" Version="12.0.4">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="Avalonia.Skia" Version="12.0.4">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="SkiaSharp" Version="3.119.4">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.5">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.4">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.5">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" Version="8.3.1.5">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="8.3.1.5">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.5">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
