<Project>
  <ItemGroup Condition="'$(IsPlugin)' == 'true'">
    <PackageReference Include="Avalonia" Version="12.0.5">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="Avalonia.Skia" Version="12.0.5">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="SkiaSharp" Version="4.148.0">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="HarfBuzzSharp" Version="14.2.0">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.148.0">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.148.0">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.148.0">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.0">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" Version="14.2.0">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.2.0">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="14.2.0">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
