<Application x:Class="Starter.Desktop.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="JetBrainsMono">avares://Starter.Desktop/Assets/Fonts#JetBrains Mono</FontFamily>
            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="/Styles/Resources.axaml" />
                <MergeResourceInclude Source="/Styles/CustomTextBox.axaml" />
                <MergeResourceInclude Source="/Styles/CustomListBox.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary x:Key="NormalMode">
                <CornerRadius x:Key="CornerRadius">17</CornerRadius>
                <CornerRadius x:Key="SearchResultCornerRadius">11</CornerRadius>
                <Thickness x:Key="ResultsPadding">7</Thickness>
                <Thickness x:Key="SeparatorPadding">13, 0</Thickness>
                <Thickness x:Key="SearchEnginePillMargin">-3, 0, 10, 0</Thickness>
                <Thickness x:Key="TextBoxMargin">0, 14, 13, 14</Thickness>
                <x:Double x:Key="TextBoxFontSize">18</x:Double>
                <x:Double x:Key="TextBoxLineHeight">24</x:Double>
                <Thickness x:Key="GridMargin">15, 0, 0, 0</Thickness>
                <x:Double x:Key="SearchResultIconSize">30</x:Double>
                <Thickness x:Key="SearchResultPadding">10, 9</Thickness>
                <x:Double x:Key="SearchResultFontSize">13</x:Double>
            </ResourceDictionary>

            <ResourceDictionary x:Key="ZoomedMode">
                <CornerRadius x:Key="CornerRadius">17</CornerRadius>
                <CornerRadius x:Key="SearchResultCornerRadius">10</CornerRadius>
                <Thickness x:Key="ResultsPadding">8</Thickness>
                <Thickness x:Key="SeparatorPadding">15, 0</Thickness>
                <Thickness x:Key="SearchEnginePillMargin">-3, 0, 10, 0</Thickness>
                <Thickness x:Key="TextBoxMargin">0, 14, 15, 15</Thickness>
                <x:Double x:Key="TextBoxFontSize">20</x:Double>
                <x:Double x:Key="TextBoxLineHeight">27</x:Double>
                <Thickness x:Key="GridMargin">18, 0, 0, 0</Thickness>
                <x:Double x:Key="SearchResultIconSize">35</x:Double>
                <Thickness x:Key="SearchResultPadding">10, 10</Thickness>
                <x:Double x:Key="SearchResultFontSize">15</x:Double>
            </ResourceDictionary>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
        <StyleInclude Source="/Styles/FontStyle.axaml" />
    </Application.Styles>
</Application>
