<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="TextBlock.title1">
        <Setter Property="FontSize">25</Setter>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="2,0,0,16" />
    </Style>
    <Style Selector="TextBlock.title2">
        <Setter Property="FontSize">14</Setter>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="2,18,0,2" />
    </Style>
</Styles>
