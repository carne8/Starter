<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ParallelCompilation>true</ParallelCompilation>
        <Deterministic>false</Deterministic>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Types.fs" />
        <Compile Include="Expression.fs" />
        <Compile Include="Parser.fs" />
        <Compile Include="Simplifications.fs" />
        <Compile Include="Evaluate.fs" />
        <Compile Include="LaTeX.fs" />
        <Compile Include="ResultControl.fs" />
        <Compile Include="Library.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="StarterApp.SearchEngineBase" Version="0.3.2" ExcludeAssets="runtime" />
        <PackageReference Include="FParsec" Version="1.1.1" />
        <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
        <PackageReference Include="MathNet.Numerics.FSharp" Version="5.0.0" />

        <ProjectReference Include="Libraries\CSharpMath\CSharpMath.Avalonia\CSharpMath.Avalonia.csproj" />
        <!--<ProjectReference Include="Libraries\CSharpMath\CSharpMath.Avalonia\CSharpMath.Avalonia.csproj" />-->
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" IncludeAssets="compile" />
    </ItemGroup>

</Project>
