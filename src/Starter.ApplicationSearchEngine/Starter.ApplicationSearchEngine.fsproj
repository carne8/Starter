<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
        <ParallelCompilation>true</ParallelCompilation>
        <Deterministic>false</Deterministic>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Starter.SearchEngineBase\Starter.SearchEngineBase.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Types.fs" />
        <Compile Include="Logger.fs" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
        <Compile Include="Windows\Uwp\Types.fs" />
        <Compile Include="Windows\Uwp\AppxManifest.fs" />
        <Compile Include="Windows\Uwp\UwpLoader.fs" />

        <Compile Include="Windows\Exe\IconHelper.fs" />
        <Compile Include="Windows\Exe\ExecutableFilesLoader.fs" />

        <Compile Include="Windows\Config.fs" />
        <Compile Include="Windows\Settings.axaml.fs" />
        <Compile Include="Windows\Library.fs" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows10.0.19041.0'">
        <AvaloniaXaml Remove="Windows\Settings.axaml" />
        <Compile Include="Linux\Types.fs" />
        <Compile Include="Linux\Helpers.fs" />

        <Compile Include="Linux\XDGDesktopFileParser.fs" />
        <Compile Include="Linux\Theme\Types.fs" />
        <Compile Include="Linux\Theme\IconThemeParser.fs" />
        <Compile Include="Linux\Theme\IconLookup.fs" />
        <Compile Include="Linux\Theme\ThemeDetection.fs" />
        <Compile Include="Linux\Theme\IconLoader.fs" />

        <Compile Include="Linux\AppsLoader.fs" />
        <Compile Include="Linux\Library.fs" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
        <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="FluentAvaloniaUI" Version="2.5.0" />
        <PackageReference Include="FluentIcons.Avalonia.Fluent" Version="2.0.319" />
        <PackageReference Include="Vanara.Windows.Shell" Version="5.0.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FsToolkit.ErrorHandling.TaskResult" Version="4.18.0" />
        <PackageReference Update="FSharp.Core" Version="10.0.101" />
    </ItemGroup>

</Project>
