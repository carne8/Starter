<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary x:Key="NormalMode">
        <CornerRadius x:Key="CornerRadius">17</CornerRadius>
        <CornerRadius x:Key="SearchResultCornerRadius">11</CornerRadius>
        <Thickness x:Key="ResultsPadding">7</Thickness>
        <Thickness x:Key="SearchEnginePillMargin">-5, 0, 0, 0</Thickness>
        <Thickness x:Key="TextBoxMargin">16</Thickness>
        <x:Double x:Key="TextBoxFontSize">16</x:Double>
        <x:Double x:Key="TextBoxLineHeight">24</x:Double>
        <Thickness x:Key="GridMargin">15, 0, 0, 0</Thickness>
        <x:Double x:Key="SearchResultIconSize">30</x:Double>
        <Thickness x:Key="SearchResultPadding">10, 8</Thickness>
        <x:Double x:Key="SearchResultFontSize">13</x:Double>
        <x:Double x:Key="SearchResultDescriptionFontSize">11</x:Double>
    </ResourceDictionary>

    <ResourceDictionary x:Key="ZoomedMode">
        <CornerRadius x:Key="CornerRadius">17</CornerRadius>
        <CornerRadius x:Key="SearchResultCornerRadius">10</CornerRadius>
        <Thickness x:Key="ResultsPadding">8</Thickness>
        <Thickness x:Key="SearchEnginePillMargin">-5, 0, 0, 0</Thickness>
        <Thickness x:Key="TextBoxMargin">16</Thickness>
        <x:Double x:Key="TextBoxFontSize">16</x:Double>
        <x:Double x:Key="TextBoxLineHeight">24</x:Double>
        <Thickness x:Key="GridMargin">18, 0, 0, 0</Thickness>
        <x:Double x:Key="SearchResultIconSize">30</x:Double>
        <Thickness x:Key="SearchResultPadding">10, 8</Thickness>
        <x:Double x:Key="SearchResultFontSize">15</x:Double>
        <x:Double x:Key="SearchResultDescriptionFontSize">13</x:Double>
    </ResourceDictionary>
</ResourceDictionary>
