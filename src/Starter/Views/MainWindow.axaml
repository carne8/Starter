<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Starter.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Starter.Controls"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="420"
        x:Class="Starter.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Design.DataContext="{Binding Source={x:Static vm:MainWindowViewModel.DesignVM}}"
        Icon="/Assets/avalonia-logo.ico"
        Title="Starter"
        SystemDecorations="None"
        Background="Transparent"
        Width="450"
        MinHeight="50"
        SizeToContent="Height"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <!-- Resources set from code-behind -->

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}" />
        </Style>

        <Style Selector="TextBox#TextBox">
            <Setter Property="Margin" Value="{DynamicResource TextBoxMargin}" />
            <Setter Property="FontSize" Value="{DynamicResource TextBoxFontSize}" />
            <Setter Property="Height" Value="{DynamicResource TextBoxLineHeight}" />
        </Style>

        <Style Selector="Border#Separator">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Height" Value="{StaticResource BorderThicknessInt}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="{DynamicResource SeparatorPadding}" />
        </Style>

        <Style Selector=":is(Window)[ActualTransparencyLevel=AcrylicBlur] Border#WindowBackground">
            <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
        </Style>
        <Style Selector=":is(Window)[ActualTransparencyLevel=Transparent] Border#WindowBackground">
            <Setter Property="Background" Value="{DynamicResource DefaultBackgroundColor}" />
        </Style>

        <Style Selector="ListBox#ResultList">
            <Setter Property="Padding" Value="{DynamicResource ResultsPadding}" />
            <Setter Property="MaxHeight" Value="380" />
        </Style>
    </Window.Styles>

    <Border x:Name="WindowBackground"
            CornerRadius="{DynamicResource CornerRadius}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="{StaticResource BorderThickness}">
        <StackPanel>
            <!-- Main text box -->
            <Grid ColumnDefinitions="Auto, *" Margin="{DynamicResource GridMargin}">
                <controls:SearchEnginePill x:Name="SearchEnginePill"
                                           Margin="{DynamicResource SearchEnginePillMargin}"
                                           IsVisible="False" />
                <TextBox x:Name="TextBox"
                         Grid.Column="1"
                         Theme="{StaticResource CustomTextBoxTheme}"
                         Watermark="Start anything..."
                         Text="{Binding Text}">
                    <TextBox.KeyBindings>
                        <KeyBinding
                            Command="{Binding ValidateResult}"
                            CommandParameter="{Binding SelectedItem, ElementName=ResultList}"
                            Gesture="Enter" />
                    </TextBox.KeyBindings>
                </TextBox>
            </Grid>

            <!-- Separator -->
            <Border x:Name="Separator"
                    IsVisible="{Binding SearchResults.Count}" /> <!-- Hide when empty -->

            <!-- Results -->
            <ListBox x:Name="ResultList"
                     ItemContainerTheme="{StaticResource CustomListBoxItem}"
                     SelectionMode="AlwaysSelected"
                     ItemsSource="{Binding SearchResults}"
                     IsVisible="{Binding SearchResults.Count}"> <!-- Hide when empty -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.KeyBindings>
                    <KeyBinding
                        Command="{Binding ValidateResult}"
                        CommandParameter="{Binding SelectedItem, ElementName=ResultList}"
                        Gesture="Enter" />
                </ListBox.KeyBindings>

                <!-- Add spacing between items -->
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Margin" Value="0, 4, 0, 0" />
                        <Setter Property="CornerRadius" Value="{DynamicResource SearchResultCornerRadius}" />
                    </Style>
                    <Style Selector="ListBoxItem:nth-child(1)"> <!-- Why is the of the first one 1 ?! -->
                        <Setter Property="Margin" Value="0, 0, 0, 0" />
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <controls:SearchResultControl />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
