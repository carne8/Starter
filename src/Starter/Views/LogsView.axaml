<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Starter.Features.LoggingView"
             x:Class="Starter.Features.LoggingView.LogsView"
             x:DataType="vm:LogsViewModel">
    <StackPanel Spacing="20">
        <!-- Filters -->
        <StackPanel Orientation="Horizontal">
            <Label Target="MinimumLevelComboBox"
                   Margin="0, 0, 10, 0"
                   VerticalAlignment="Center">
                Minimum log level
            </Label>
            <ComboBox x:Name="MinimumLevelComboBox"
                      SelectedItem="{Binding MinimumLevel}"
                      ItemsSource="{Binding LogLevels}" />
        </StackPanel>

        <!-- Logs -->
        <Border Padding="10"
                Background="#B3FFFFFF"
                BorderBrush="#0F000000"
                BorderThickness="{StaticResource BorderThickness}"
                CornerRadius="8">
            <SelectableTextBlock Text="{Binding Text}" />
        </Border>
    </StackPanel>

</UserControl>
