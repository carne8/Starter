<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Starter.SearchEngine"
             xmlns:controls="using:Starter.Controls"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="60"
             x:Class="Starter.Controls.SearchEnginePill"
             x:DataType="vm:ISearchEngineActivator">
    <Border Background="{DynamicResource SearchEnginePillBackground}"
            Padding="7, 5, 6, 5"
            CornerRadius="100"
            Height="27">
        <StackPanel Orientation="Horizontal" Spacing="5">
            <controls:StarterIcon Margin="-2, 0, 0, 0"
                                  VerticalAlignment="Stretch"
                                  Height="17"
                                  Width="17"
                                  FontSize="17"
                                  IsVisible="{Binding Icon, TargetNullValue=False}"
                                  IconSource="{Binding Icon}" />

            <TextBlock x:Name="Text"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SearchEnginePillForeground}"
                       Text="{Binding ShortName}"
                       VerticalAlignment="Center"
                       LineHeight="17" />
        </StackPanel>
    </Border>
</UserControl>
