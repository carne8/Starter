<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Pen x:Key="IconPen"
         Brush="{DynamicResource IconsColor}"
         Thickness="1.5"
         LineCap="Round"
         LineJoin="Round" />
    <DrawingImage x:Key="Power" Viewbox="0,0,24,24">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="F1 M12 2v10" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M18.4 6.6a9 9 0 1 1-12.77.04" Pen="{StaticResource IconPen}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Paintbrush" Viewbox="0,0,24,24">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="F1 m14.622 17.897-10.68-2.913" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M18.376 2.622a1 1 0 1 1 3.002 3.002L17.36 9.643a.5.5 0 0 0 0 .707l.944.944a2.41 2.41 0 0 1 0 3.408l-.944.944a.5.5 0 0 1-.707 0L8.354 7.348a.5.5 0 0 1 0-.707l.944-.944a2.41 2.41 0 0 1 3.408 0l.944.944a.5.5 0 0 0 .707 0z" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M9 8c-1.804 2.71-3.97 3.46-6.583 3.948a.507.507 0 0 0-.302.819l7.32 8.883a1 1 0 0 0 1.185.204C12.735 20.405 16 16.792 16 15" Pen="{StaticResource IconPen}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="ZoomIn" Viewbox="0,0,24,24">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="8"
                                         RadiusY="8"
                                         Center="11,11" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="21,21" EndPoint="16.65,16.65" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="11,8" EndPoint="11,14" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="8,11" EndPoint="14,11" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="CaseSensitive" Viewbox="0,0,24,24">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="F1 m2 16 4.039-9.69a.5.5 0 0 1 .923 0L11 16" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M22 9v7" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M3.304 13h6.392" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="3.5"
                                         RadiusY="3.5"
                                         Center="18.5,12.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="AppWindow" Viewbox="0,0,24,24">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="2"
                                           RadiusY="2"
                                           Rect="2,4,20,16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="F1 M10 4v4" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M2 8h20" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M6 4v4" Pen="{StaticResource IconPen}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Keyboard" Viewbox="0,0,24,24">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="F1 M10 8h.01" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M12 12h.01" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M14 8h.01" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M16 12h.01" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M18 8h.01" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M6 8h.01" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M7 16h10" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Geometry="F1 M8 12h.01" Pen="{StaticResource IconPen}" />
                <GeometryDrawing Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry RadiusX="2"
                                           RadiusY="2"
                                           Rect="2,4,20,16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="ScrollText" Viewbox="0,0,24,24">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M 0,0 L 24,0 24,24 0,24 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
