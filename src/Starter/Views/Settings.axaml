<UserControl x:Class="Starter.Views.Settings"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Starter.ViewModels"
             xmlns:controls="using:Starter.Controls"
             d:DesignHeight="450"
             d:DesignWidth="600"
             x:DataType="vm:SettingsViewModel"
             mc:Ignorable="d">
    <UserControl.Resources>
        <StreamGeometry x:Key="Power">M18.2929,4.8694 C22.2336,6.54125 25,10.4467 25,15 C25,21.0751 20.0751,26 14,26 C7.92487,26 3,21.0751 3,15 C3,10.4467 5.76636,6.54125 9.70708,4.8694 C10.0884,4.70762 10.5287,4.8856 10.6904,5.26691 C10.8522,5.64823 10.6742,6.08849 10.2929,6.25027 C6.88678,7.69533 4.5,11.0698 4.5,15 C4.5,20.2467 8.75329,24.5 14,24.5 C19.2467,24.5 23.5,20.2467 23.5,15 C23.5,11.0698 21.1132,7.69533 17.7071,6.25027 C17.3258,6.08849 17.1478,5.64823 17.3096,5.26691 C17.4713,4.8856 17.9116,4.70762 18.2929,4.8694 Z M14,2 C14.4142,2 14.75,2.33579 14.75,2.75 L14.75,12.25 C14.75,12.6642 14.4142,13 14,13 C13.5858,13 13.25,12.6642 13.25,12.25 L13.25,2.75 C13.25,2.33579 13.5858,2 14,2 Z</StreamGeometry>
        <StreamGeometry x:Key="Background">M6.75 1C6.33579 1 6 1.33579 6 1.75V3.50559C5.96824 3.53358 5.93715 3.56276 5.9068 3.59311L1.66416 7.83575C0.883107 8.6168 0.883107 9.88313 1.66416 10.6642L5.19969 14.1997C5.98074 14.9808 7.24707 14.9808 8.02812 14.1997L12.2708 9.95707C13.0518 9.17602 13.0518 7.90969 12.2708 7.12864L8.73522 3.59311C8.39027 3.24816 7.95066 3.05555 7.5 3.0153V1.75C7.5 1.33579 7.16421 1 6.75 1ZM6 5.62123V6.25C6 6.66421 6.33579 7 6.75 7C7.16421 7 7.5 6.66421 7.5 6.25V4.54033C7.56363 4.56467 7.62328 4.60249 7.67456 4.65377L11.2101 8.1893C11.2995 8.27875 11.348 8.39366 11.3555 8.51071H3.11052L6 5.62123ZM6.26035 13.1391L3.132 10.0107H10.0958L6.96746 13.1391C6.77219 13.3343 6.45561 13.3343 6.26035 13.1391Z M2 17.5V12.4143L3.5 13.9143V17.5C3.5 18.0523 3.94772 18.5 4.5 18.5H19.5C20.0523 18.5 20.5 18.0523 20.5 17.5V6.5C20.5 5.94771 20.0523 5.5 19.5 5.5H12.0563L10.5563 4H19.5C20.8807 4 22 5.11929 22 6.5V17.5C22 18.8807 20.8807 20 19.5 20H4.5C3.11929 20 2 18.8807 2 17.5Z M11 14.375C11 13.8816 11.1541 13.4027 11.3418 12.9938C11.5325 12.5784 11.7798 12.1881 12.0158 11.8595C12.2531 11.5289 12.4888 11.247 12.6647 11.0481C12.7502 10.9515 12.9062 10.7867 12.9642 10.7254L12.9697 10.7197C13.2626 10.4268 13.7374 10.4268 14.0303 10.7197L14.3353 11.0481C14.5112 11.247 14.7469 11.5289 14.9842 11.8595C15.2202 12.1881 15.4675 12.5784 15.6582 12.9938C15.8459 13.4027 16 13.8816 16 14.375C16 15.7654 14.9711 17 13.5 17C12.0289 17 11 15.7654 11 14.375ZM13.7658 12.7343C13.676 12.6092 13.5858 12.4916 13.5 12.3844C13.4142 12.4916 13.324 12.6092 13.2342 12.7343C13.0327 13.015 12.8425 13.32 12.7051 13.6195C12.5647 13.9253 12.5 14.1808 12.5 14.375C12.5 15.0663 12.9809 15.5 13.5 15.5C14.0191 15.5 14.5 15.0663 14.5 14.375C14.5 14.1808 14.4353 13.9253 14.2949 13.6195C14.1575 13.32 13.9673 13.015 13.7658 12.7343Z</StreamGeometry>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="4">
            <TextBlock Margin="0,0,0,16" Classes="title1">Settings</TextBlock>

            <!-- Launch at startup -->
            <ui:FASettingsExpander Header="Launch at startup">
                <ui:FASettingsExpander.Styles>
                    <Style Selector="ContentPresenter#IconPresenter">
                        <Setter Property="Padding" Value="3" />
                    </Style>
                </ui:FASettingsExpander.Styles>
                <ui:FASettingsExpander.IconSource>
                    <ui:FAPathIconSource Data="{StaticResource Power}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <Panel>
                        <ui:FAProgressRing IsVisible="{Binding LaunchAtStartupLoading}" />
                        <ToggleSwitch IsChecked="{Binding LaunchAtStartup}" IsVisible="{Binding !LaunchAtStartupLoading}" />
                    </Panel>
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <!-- Keyboard shortcut -->
            <controls:KeyboardShortcutInput DataContext="{Binding KeyboardShortcutViewModel}" ControlToFocus="{Binding #ComboBox}" />

            <TextBlock Classes="title2">Personalization</TextBlock>

            <!-- Background -->
            <ui:FASettingsExpander Description="{x:Static vm:SettingsViewModel.BackgroundDescription}" Header="Background transparency">
                <ui:FASettingsExpander.Styles>
                    <Style Selector="ContentPresenter#IconPresenter">
                        <Setter Property="Padding" Value="3" />
                    </Style>
                </ui:FASettingsExpander.Styles>
                <ui:FASettingsExpander.IconSource>
                    <ui:FAPathIconSource Data="{StaticResource Background}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>

                    <ComboBox x:Name="ComboBox"
                              ItemsSource="{x:Static vm:SettingsViewModel.Backgrounds}"
                              SelectedItem="{Binding SelectedBackground}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:BackgroundKind">
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                        <ComboBox.Styles>
                            <Style x:DataType="vm:BackgroundKind" Selector="ComboBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding Available}" />
                            </Style>
                        </ComboBox.Styles>
                    </ComboBox>

                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <!-- Zoomed mode -->
            <ui:FASettingsExpander Header="Zoomed mode">
                <ui:FASettingsExpander.IconSource>
                    <ui:FASymbolIconSource Symbol="ZoomIn" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ZoomedMode}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <TextBlock Classes="title2">Search engine activation prefixes</TextBlock>

            <!-- Activator prefixes -->
            <ItemsControl ItemsSource="{Binding ActivatorViewModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ActivatorInputFieldViewModel">

                        <controls:CustomSettingsExpander Header="{Binding Name}"
                                                         Footer="{Binding}"
                                                         StarterIconSource="{Binding Icon}"
                                                         Theme="{DynamicResource SettingsExpanderExpanderStyle}">
                            <controls:CustomSettingsExpander.Template />

                            <controls:CustomSettingsExpander.FooterTemplate>
                                <DataTemplate DataType="vm:ActivatorInputFieldViewModel">
                                    <TextBox Text="{Binding ActivationString}" />
                                </DataTemplate>
                            </controls:CustomSettingsExpander.FooterTemplate>
                        </controls:CustomSettingsExpander>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
