        <StreamGeometry x:Key="Antialiasing">M16.5106 3.00008C16.8242 3.00452 17.1019 3.20362 17.2068 3.49919L22.7068 18.9992C22.8453 19.3896 22.6411 19.8183 22.2508 19.9568C21.8604 20.0953 21.4317 19.8912 21.2931 19.5008L19.8735 15.5L12.7558 15.5L11.1994 19.5207C11.0499 19.907 10.6155 20.099 10.2292 19.9494C9.84293 19.7999 9.651 19.3655 9.80053 18.9793L15.8005 3.47925C15.9137 3.18678 16.197 2.99563 16.5106 3.00008ZM16.4694 5.90659L13.3364 14L19.3412 14L16.4694 5.90659Z M5.50005 10.5014L5.78725 10.5113C7.74783 10.6088 8.91466 11.7373 8.9955 13.5555L9 13.7604V19.2604C9 19.6401 8.71785 19.9539 8.35177 20.0035L8.25 20.0104C7.8703 20.0104 7.55651 19.7282 7.50685 19.3621L7.5 19.2604L7.49865 19.156C6.51108 19.7214 5.59755 20.0104 4.75 20.0104C2.91158 20.0104 1.5 18.7159 1.5 16.7604C1.5 15.036 2.68843 13.7549 4.6597 13.5158C5.592 13.4028 6.53953 13.4736 7.49853 13.7255C7.4887 12.6184 6.94255 12.0706 5.71275 12.0095C4.75051 11.9616 4.07429 12.0967 3.67825 12.3744C3.33911 12.6123 2.87139 12.5301 2.63357 12.191C2.39576 11.8518 2.47789 11.3841 2.81703 11.1463C3.47484 10.685 4.37072 10.4807 5.50005 10.5014ZM7.499 15.3241L7.19613 15.2338C6.38875 15.0117 5.60483 14.9486 4.8403 15.0413C3.60791 15.1908 3 15.8461 3 16.7967C3 17.8934 3.7124 18.5467 4.75 18.5467C5.43032 18.5467 6.26848 18.2324 7.25129 17.583L7.499 17.4141V15.3241Z</StreamGeometry>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="4">
            <TextBlock Margin="0,0,0,16" Classes="title1">Settings</TextBlock>

            <!-- Launch at startup -->
            <ui:FASettingsExpander Header="Launch at startup">
                <ui:FASettingsExpander.Styles>
                    <Style Selector="ContentPresenter#IconPresenter">
                        <Setter Property="Padding" Value="3" />
                    </Style>
                </ui:FASettingsExpander.Styles>
                <ui:FASettingsExpander.IconSource>
                    <ui:FAPathIconSource Data="{StaticResource Power}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <Panel>
                        <ui:FAProgressRing IsVisible="{Binding LaunchAtStartupLoading}" />
                        <ToggleSwitch IsChecked="{Binding LaunchAtStartup}" IsVisible="{Binding !LaunchAtStartupLoading}" />
                    </Panel>
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <!-- Keyboard shortcut -->
            <controls:KeyboardShortcutInput DataContext="{Binding KeyboardShortcutViewModel}" ControlToFocus="{Binding #BackgroundComboBox}" />

            <TextBlock Classes="title2">Personalization</TextBlock>

            <!-- Background -->
            <ui:FASettingsExpander Description="{OnPlatform Windows={x:Null}, Default='Acrylic and Mica background are not supported on Linux'}" Header="Background transparency">
                <ui:FASettingsExpander.Styles>
                    <Style Selector="ContentPresenter#IconPresenter">
                        <Setter Property="Padding" Value="3" />
                    </Style>
                </ui:FASettingsExpander.Styles>
                <ui:FASettingsExpander.IconSource>
                    <ui:FAPathIconSource Data="{StaticResource Background}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>

                    <ComboBox x:Name="BackgroundComboBox"
                              ItemsSource="{x:Static vm:SettingsViewModel.Backgrounds}"
                              SelectedItem="{Binding SelectedBackground}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:BackgroundKind">
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                        <ComboBox.Styles>
                            <Style x:DataType="vm:BackgroundKind" Selector="ComboBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding Available}" />
                            </Style>
                        </ComboBox.Styles>
                    </ComboBox>

                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <!-- Zoomed mode -->
            <ui:FASettingsExpander Header="Zoomed mode">
                <ui:FASettingsExpander.IconSource>
                    <ui:FASymbolIconSource Symbol="ZoomIn" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ZoomedMode}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <!-- Antialiasing -->
            <ui:FASettingsExpander Header="Antialiasing">
                <ui:FASettingsExpander.Styles>
                    <Style Selector="ContentPresenter#IconPresenter">
                        <Setter Property="Padding" Value="3" />
                    </Style>
                </ui:FASettingsExpander.Styles>
                <ui:FASettingsExpander.IconSource>
                    <ui:FAPathIconSource Data="{StaticResource Antialiasing}" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>

                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Antialiasings}" SelectedItem="{Binding SelectedAntialiasing}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:AntialiasingKind">
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <TextBlock Classes="title2">Search engine activation prefixes</TextBlock>

            <!-- Activator prefixes -->
            <ItemsControl ItemsSource="{Binding ActivatorViewModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ActivatorInputFieldViewModel">

                        <controls:CustomSettingsExpander Header="{Binding Name}"
                                                         Footer="{Binding}"
                                                         StarterIconSource="{Binding Icon}"
                                                         Theme="{DynamicResource SettingsExpanderExpanderStyle}">
                            <controls:CustomSettingsExpander.Template />

                            <controls:CustomSettingsExpander.FooterTemplate>
                                <DataTemplate DataType="vm:ActivatorInputFieldViewModel">
                                    <TextBox Text="{Binding ActivationString}" />
                                </DataTemplate>
                            </controls:CustomSettingsExpander.FooterTemplate>
                        </controls:CustomSettingsExpander>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Directory buttons -->
            <TextBlock Classes="title2">Directories</TextBlock>
            <WrapPanel Orientation="Horizontal"
                       ItemSpacing="6"
                       LineSpacing="6">
                <Button Command="{Binding OpenConfigDirectoryCommand}">
                    <TextBlock>Open config directory</TextBlock>
                </Button>
                <Button Command="{Binding OpenSearchEnginesDirectoryCommand}">
                    <TextBlock>Open search engines directory</TextBlock>
                </Button>
                <Button Command="{Binding OpenLogsDirectoryCommand}">
                    <TextBlock>Open logs directory</TextBlock>
                </Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
