<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Starter.SearchEngineBase\Starter.SearchEngineBase.csproj" />
    </ItemGroup>

    <!-- Features -->
    <ItemGroup>
        <Compile Include="Features\Constants.fs" />
        
        <!-- Platform interop -->
        <Compile Include="Features\Helpers.fs" />
        <Compile Include="Features\PlatformInterop\PlatformInterop.fs" />
        <Compile Include="Features\PlatformInterop\Windows.fs" />
        <Compile Include="Features\PlatformInterop\Linux.fs" />
        <Compile Include="Features\PlatformInterop\PlatformInteropFactory.fs" />

        <!-- Config-->
        <Compile Include="Features\Configuration\Config.fs" />
        <Compile Include="Features\Configuration\StarterSettings\StarterSettingsViewModel.fs" />
        <Compile Include="Features\Configuration\StarterSettings\StarterSettings.axaml.fs">
            <DependentUpon>Settings.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Include="Features\Configuration\SettingsWindow\SettingsWindowViewModel.fs" />
        <Compile Include="Features\Configuration\SettingsWindow\SettingsWindow.axaml.fs">
            <DependentUpon>Settings.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>

        <!-- Internal search engines -->
        <Compile Include="Features\InternalSearchEngines\Settings\SettingsSearchEngine.fs" />

        <!-- Others -->
        <Compile Include="Features\SearchEngineLoading.fs" />
        <Compile Include="Features\ResultScores.fs" />
        <Compile Include="Features\ObservableList.fs" />
    </ItemGroup>

    <ItemGroup>
        <!-- Custom Controls -->
        <Compile Include="Controls\AccentuatedTextBlock.fs" />

        <!-- View models -->
        <Compile Include="ViewModels\ViewModelBase.fs" />
        <Compile Include="ViewModels\SearchResultViewModel.fs" />
        <Compile Include="ViewModels\SingleSearchEngineViewModel.fs" />
        <Compile Include="ViewModels\MainWindowViewModel.fs" />

        <!-- Views -->
        <Compile Include="Views\SearchResult.axaml.fs">
            <DependentUpon>SearchResult.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Include="Views\SearchEnginePill.axaml.fs">
            <DependentUpon>SearchEnginePill.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Include="Views\MainWindow.axaml.fs">
            <DependentUpon>MainWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>

        <!-- Entry point -->
        <Compile Include="ViewLocator.fs" />
        <Compile Include="App.axaml.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fusil" Version="1.0.7" />
        <PackageReference Include="MemoryPack" Version="1.21.4" />
        <PackageReference Include="FsToolkit.ErrorHandling.TaskResult" Version="4.18.0" />
        <PackageReference Include="R3" Version="1.3.0" />
        <PackageReference Include="System.Drawing.Common" Version="9.0.5" />
        <PackageReference Include="Thoth.Json.Net" Version="12.0.0" />
        <PackageReference Include="Vanara.PInvoke.Shell32" Version="4.1.3" />
        <PackageReference Include="Vanara.PInvoke.User32" Version="4.1.3" />
        <PackageReference Include="Vanara.Windows.Shell" Version="4.1.3" />
    </ItemGroup>

    <!-- Avalonia related packages -->
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.0" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
        <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.0">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="FluentAvaloniaUI" Version="2.3.0" />
        <PackageReference Include="FluentIcons.Avalonia.Fluent" Version="1.1.300" />
        <PackageReference Include="R3Extensions.Avalonia" Version="1.3.0" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="11.3.0.1" />
    </ItemGroup>
</Project>
