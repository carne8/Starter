        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Shared</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="IconHelper.fs" />
        <Compile Include="ContextMenu.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="StarterApp.SearchEngineBase" Version="0.4.0" ExcludeAssets="runtime" />
        <PackageReference Include="Vanara.Windows.Shell" Version="5.0.8" />
        <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    </ItemGroup>

</Project>
