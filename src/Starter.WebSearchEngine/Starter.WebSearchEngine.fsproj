<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ParallelCompilation>true</ParallelCompilation>
        <Deterministic>false</Deterministic>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <RootNamespace>Starter.WebSearchEngine</RootNamespace>
        <IsPlugin>true</IsPlugin>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Images/*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Compile Include="Logger.fs" />
        <Compile Include="Types.fs" />
        <Compile Include="Config.fs" />
        <Compile Include="Settings.axaml.fs" />
        <Compile Include="Library.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="StarterApp.SearchEngineBase" Version="0.3.0" />
        <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.8" />
        <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
    </ItemGroup>

</Project>
