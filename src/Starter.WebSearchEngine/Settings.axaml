<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Starter.WebSearchEngine.Views"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Starter.WebSearchEngine.Views.Settings"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Spacing="4">
            <TextBlock Classes="title1" Margin="0, 0, 0, 16">Web search settings</TextBlock>

            <!-- Search engine -->
            <ui:SettingsExpander x:Name="SearchEngine" Header="Search engine"> <!-- Icon source bound from code-behind -->
                <ui:SettingsExpander.Footer>
                    <ComboBox SelectedItem="{Binding SelectedSeKind}" ItemsSource="{Binding SearchEngineKinds}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ui:SettingsExpander.Footer>
            </ui:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
