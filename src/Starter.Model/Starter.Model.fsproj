<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ParallelCompilation>true</ParallelCompilation>
        <Deterministic>false</Deterministic>
        <Nullable>enable</Nullable>
        <RootNamespace>Starter</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Starter.SearchEngineBase\Starter.SearchEngineBase.csproj" />
    </ItemGroup>

    <!-- Features -->
    <ItemGroup>
        <Compile Include="Features\Constants.fs" />
        <Compile Include="Features\Helpers.fs" />
        <Compile Include="Features\Logging.fs" />
        <Compile Include="Features\Config.fs" />

        <!-- Platform interop -->
        <Compile Include="Features\PlatformInterop\PlatformInterop.fs" />
        <Compile Include="Features\PlatformInterop\Linux\Common.fs" />
        <Compile Include="Features\PlatformInterop\Linux\Gnome.fs" />
        <Compile Include="Features\PlatformInterop\Linux\KeyboardShortcut.fs" />
        <Compile Include="Features\PlatformInterop\LinuxPlatformInterop.fs" />
        <Compile Include="Features\PlatformInterop\WindowsPlatformInterop.fs" />
        <Compile Include="Features\PlatformInterop\PlatformInteropFactory.fs" />

        <Compile Include="Features\SearchEngineLoading.fs" />
        <Compile Include="Features\ResultScores.fs" />
        <Compile Include="Features\ActivatorStore.fs" />
        <Compile Include="Features\CustomCollections.fs" />
        <Compile Include="Features\SearchResultData.fs" />
        <Compile Include="Features\SearchResultStore.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fusil" Version="1.0.7" />
        <PackageReference Include="MemoryPack" Version="1.21.4" />
        <PackageReference Include="FsToolkit.ErrorHandling" Version="5.1.0" />
        <PackageReference Include="ObservableCollections" Version="3.3.4" />
        <PackageReference Include="R3" Version="1.3.0" />
        <PackageReference Include="Serilog" Version="4.3.0" />
        <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" Condition="'$(Configuration)' == 'Debug' Or $(DefineConstants.Contains(DEBUG_LOGS))" />
        <PackageReference Include="System.Drawing.Common" Version="10.0.1" />
        <PackageReference Include="Thoth.Json.Net" Version="12.0.0" />
        <PackageReference Include="Tmds.DBus" Version="0.22.0" />
        <PackageReference Include="Vanara.PInvoke.Shell32" Version="4.2.1" />
        <PackageReference Include="Vanara.PInvoke.User32" Version="4.2.1" />
        <PackageReference Include="Vanara.Windows.Shell" Version="4.2.1" />
    </ItemGroup>

    <!-- Avalonia related packages -->
    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
        <PackageReference Include="Avalonia.Win32" Version="11.3.10" />
        <PackageReference Include="FluentAvaloniaUI" Version="2.4.1" />
        <PackageReference Include="R3Extensions.Avalonia" Version="1.3.0" />
    </ItemGroup>
</Project>
